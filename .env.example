# Copy to .env.local for local dev, and set the same in the Vercel dashboard
# (Project → Settings → Environment Variables) for production.
#
# ALL of these are optional. With none set, the app behaves exactly like
# v1.5.0: no passcode gate, favorites stored in the browser only.

# ---- Passcode gate (app/middleware.js) ----
# Set BOTH to turn on the single-passcode gate. Leave unset to keep the app
# open. APP_PASSCODE is the passcode you type; SESSION_SECRET signs the login
# cookie (use a long random string — e.g. `openssl rand -hex 32`).
APP_PASSCODE=
SESSION_SECRET=

# ---- Database (lib/db.js, favorites persistence) ----
# Auto-populated by the Vercel Postgres integration (Storage → Postgres).
# When present, favorites sync to the DB; when absent, favorites stay in
# localStorage only. You normally don't set this by hand on Vercel.
POSTGRES_URL=
